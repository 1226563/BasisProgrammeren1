<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="codebreaker keuzes"/>
        <attribute name="authors" value="jayde"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-25 04:18:52 "/>
        <attribute name="created" value="amF5ZGU7U0NIT09MTEFQVE9QOzIwMjYtMDktMjU7IjAyOjU2OjI3ICI7MjY0OA=="/>
        <attribute name="edited" value="amF5ZGU7U0NIT09MTEFQVE9QOzIwMjYtMDktMjU7IjAyOjU2OjMwICI7MTtqYXlkZTtTQ0hPT0xMQVBUT1A7MjAyNi0wOS0xODsiMDI6NTg6MzcgIjtjb2RlYnJlYWtlciBpbnB1dCBvdXRwdXQuZnByZzs4NDU0"/>
        <attribute name="edited" value="amF5ZGU7U0NIT09MTEFQVE9QOzIwMjYtMDktMjU7IjA0OjE4OjUyICI7NDsyNzU3"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="codemaker, codekraker" type="String" array="False" size=""/>
            <declare name="blauwPin, oranjePin, paarsPin, groenPin, roodPin, geelPin" type="String" array="False" size=""/>
            <declare name="zwartePinnen, wittePinnen" type="Integer" array="False" size=""/>
            <assign variable="blauwPin" expression="&quot;blauw&quot;"/>
            <assign variable="oranjePin" expression="&quot;oranje&quot;"/>
            <assign variable="paarsPin" expression="&quot;paars&quot;"/>
            <assign variable="groenPin" expression="&quot;groen&quot;"/>
            <assign variable="roodPin" expression="&quot;rood&quot;"/>
            <assign variable="geelPin" expression="&quot;geel&quot;"/>
            <assign variable="zwartePinnen" expression="0"/>
            <assign variable="wittePinnen" expression="0"/>
            <declare name="gok1, gok2, gok3, gok4" type="String" array="False" size=""/>
            <declare name="codePin1, codePin2, codePin3, codePin4" type="String" array="False" size=""/>
            <assign variable="codePin1" expression="blauwPin"/>
            <assign variable="codePin2" expression="groenPin"/>
            <assign variable="codePin3" expression="roodPin"/>
            <assign variable="codePin4" expression="geelPin"/>
            <output expression="&quot;Voer kleur 1 in:&quot;" newline="True"/>
            <input variable="gok1"/>
            <output expression="&quot;Voer kleur 2 in:&quot;" newline="True"/>
            <input variable="gok2"/>
            <output expression="&quot;Voer kleur 3 in:&quot;" newline="True"/>
            <input variable="gok3"/>
            <output expression="&quot;Voer kleur 4 in:&quot;" newline="True"/>
            <input variable="gok4"/>
            <if expression="gok1 = codePin1">
                <then>
                    <output expression="&quot;Zwart&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="gok1 = codePin2">
                        <then>
                            <output expression="&quot;wit&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="gok1 = codePin3">
                                <then>
                                    <output expression="&quot;wit&quot;" newline="True"/>
                                </then>
                                <else>
                                    <if expression="gok1 = codePin4">
                                        <then>
                                            <output expression="&quot;wit&quot;" newline="True"/>
                                        </then>
                                        <else>
                                            <output expression="&quot;niks&quot;" newline="True"/>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <if expression="gok2 = codePin2">
                <then>
                    <output expression="&quot;Zwart&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="gok2 = codePin1">
                        <then>
                            <output expression="&quot;wit&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="gok2 = codePin3">
                                <then>
                                    <output expression="&quot;wit&quot;" newline="True"/>
                                </then>
                                <else>
                                    <if expression="gok2 = codePin4">
                                        <then>
                                            <output expression="&quot;wit&quot;" newline="True"/>
                                        </then>
                                        <else>
                                            <output expression="&quot;niks&quot;" newline="True"/>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <if expression="gok3 = codePin3">
                <then>
                    <output expression="&quot;Zwart&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="gok3 = codePin1">
                        <then>
                            <output expression="&quot;wit&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="gok3 = codePin2">
                                <then>
                                    <output expression="&quot;wit&quot;" newline="True"/>
                                </then>
                                <else>
                                    <if expression="gok2 = codePin4">
                                        <then>
                                            <output expression="&quot;wit&quot;" newline="True"/>
                                        </then>
                                        <else>
                                            <output expression="&quot;niks&quot;" newline="True"/>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <if expression="gok4 = codePin4">
                <then>
                    <output expression="&quot;Zwart&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="gok4 = codePin1">
                        <then>
                            <output expression="&quot;wit&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="gok4 = codePin2">
                                <then>
                                    <output expression="&quot;wit&quot;" newline="True"/>
                                </then>
                                <else>
                                    <if expression="gok4 = codePin3">
                                        <then>
                                            <output expression="&quot;wit&quot;" newline="True"/>
                                        </then>
                                        <else>
                                            <output expression="&quot;niks&quot;" newline="True"/>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="&quot;Jouw gok is: &quot; &amp; gok1 &amp; &quot; &quot; &amp; gok2 &amp; &quot; &quot; &amp; gok3 &amp; &quot; &quot; &amp; gok4" newline="True"/>
            <if expression="gok1 = codePin1 and gok2 = codePin2 and gok3 = codePin3 and gok4 = codePin4">
                <then>
                    <output expression="&quot;gewonnen&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;verloren&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
